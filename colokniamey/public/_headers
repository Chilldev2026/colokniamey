# Turnstile (M2, RGP19) : script et cadre de challenges.cloudflare.com, seul service tiers à déclarer dans la politique.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://ltwotymheaverxdruqud.supabase.co; font-src 'self'; connect-src 'self' https://ltwotymheaverxdruqud.supabase.co wss://ltwotymheaverxdruqud.supabase.co; worker-src 'self'; frame-src https://challenges.cloudflare.com; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=()
  X-Content-Type-Options: nosniff
